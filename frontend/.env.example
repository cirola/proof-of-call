# Copy to `.env.local` and fill in. `.env*` is gitignored except this file.

# Address of the deployed CallRegistry on Sepolia. Printed by
# `npm run deploy:sepolia` in the repository root.
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed PriceOracleResolver. The reveal flow needs it to read
# each asset's aggregator and staleness threshold.
VITE_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud project id — https://cloud.reown.com. Injected wallets
# (MetaMask, Rabby) work without it; QR-code and mobile wallets do not.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Falls back to the public Sepolia RPC, which is rate-limited and will
# make the reveal round search slow.
VITE_SEPOLIA_RPC_URL=
