# Copy to `.env.local` and fill in. `.env*` is gitignored except this file.
#
# `npm run demo` writes this file for you, pointed at a local Hardhat node.
# Everything below is for a real deployment.

# Chain this build talks to. 11155111 = Sepolia (the default if unset),
# 31337 = the local Hardhat node. A build targets exactly one chain.
VITE_CHAIN_ID=11155111

# Address of the deployed CallRegistry. Printed by `npm run deploy:sepolia` in
# the repository root.
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed PriceOracleResolver. The reveal flow needs it to read
# each asset's aggregator and staleness threshold.
VITE_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# Block the registry was deployed in. Log queries start here instead of at zero,
# which is the difference between two requests and two thousand. Read it off the
# deployment transaction on Etherscan.
VITE_DEPLOY_BLOCK=0

# WalletConnect Cloud project id — https://cloud.reown.com. Injected wallets
# (MetaMask, Rabby) work without it; QR-code and mobile wallets do not.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Falls back to the chain's own default, which for Sepolia is a
# rate-limited public endpoint that will make the reveal round search slow.
# Use an endpoint that answers eth_getLogs over a wide range.
VITE_RPC_URL=
