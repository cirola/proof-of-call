# Copy to .env ONLY for values that are not secrets.
#
# Secrets (SEPOLIA_PRIVATE_KEY, ETHERSCAN_API_KEY, and any RPC URL with an
# embedded project token) belong in the encrypted Hardhat keystore, NOT here:
#
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   npx hardhat keystore set ETHERSCAN_API_KEY
#
# hardhat.config.ts reads all three through configVariable(), which checks the
# keystore before falling back to the environment. This file documents the
# variable names only.

# JSON-RPC endpoint for Sepolia. If your provider embeds an API token in the
# URL, treat the whole URL as a secret and use the keystore.
SEPOLIA_RPC_URL=

# Private key of a DEDICATED, DISPOSABLE deploy wallet funded only from a
# faucet. Never a wallet that has touched mainnet or holds real funds.
SEPOLIA_PRIVATE_KEY=

# Etherscan API v2 key (a single key covers all supported chains).
ETHERSCAN_API_KEY=
